      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (app) (up{namespace=\"artelab\",app=~\"artelab|usuarios\"})",
          "legendFormat": "{{app}}",
          "refId": "A"
